# === База данных (общая БД, к которой позже подключится Orchestrator/Gateway) ===
DATABASE_URL=postgres://user:password@host:5432/relaxnet

# Публичный адрес сайта (используется для return_url ЮKassa и ссылок в письмах)
APP_URL=https://relaxnet.pro

# === SMTP / nodemailer (отправка OTP-кодов и VPN-ключа) ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@relaxnet.pro
SMTP_PASS=
SMTP_FROM="RelaxNet <no-reply@relaxnet.pro>"

# === ЮKassa ===
# Тестовые ключи берутся в личном кабинете ЮKassa (режим "Тестовый магазин")
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

